# Manuphet 環境変数テンプレート
# 環境変数は settings.json より優先されます（すべて省略可）。
# .env は git 追跡対象外です（.gitignore 参照）。

# ------------------------------------------------------------------
# Web サーバー
# ------------------------------------------------------------------
MANUPHET_HOST=0.0.0.0
MANUPHET_PORT=8000

# ------------------------------------------------------------------
# データ保存先（省略時: %ProgramData%\Manuphet\data）
# ------------------------------------------------------------------
# MANUPHET_DATA_DIR=C:\ProgramData\Manuphet\data
# MANUPHET_MODELS_DIR=C:\ProgramData\Manuphet\data\models
# MANUPHET_LOG_DIR=C:\ProgramData\Manuphet\data\logs
# MANUPHET_CONFIG_DIR=C:\ProgramData\Manuphet\data\config
# MANUPHET_DB_PATH=C:\ProgramData\Manuphet\data\manuphet.db

# ------------------------------------------------------------------
# MySQL 接続（Web 画面の「MySQL連携」タブでも設定可能）
# ------------------------------------------------------------------
# MANUPHET_MYSQL_HOST=127.0.0.1
# MANUPHET_MYSQL_PORT=3306
# MANUPHET_MYSQL_USER=
# MANUPHET_MYSQL_PASSWORD=
# MANUPHET_MYSQL_DATABASE=
# MANUPHET_MYSQL_DRIVER=mysqlconnector

# ------------------------------------------------------------------
# 学習・通知
# ------------------------------------------------------------------
MANUPHET_ALLOW_WEB_TRAIN=1
MANUPHET_NOTIFY_AUTO=1
MANUPHET_NOTIFY_INTERVAL_MIN=360
MANUPHET_AUTO_RETRAIN_MONTHLY=1
# MANUPHET_SEARCH_ITER=100
# MANUPHET_ENABLE_CUSTOMER_FEATURES=0

# ------------------------------------------------------------------
# メール通知（SMTP。Web 画面の「通知設定」タブでも設定可能）
# ------------------------------------------------------------------
# MANUPHET_SMTP_HOST=smtp.example.com
# MANUPHET_SMTP_PORT=587
# MANUPHET_SMTP_USER=
# MANUPHET_SMTP_PASS=
# MANUPHET_SMTP_FROM=noreply@example.com
